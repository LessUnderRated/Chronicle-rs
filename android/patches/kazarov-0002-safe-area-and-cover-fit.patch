diff --git a/port/gfx/gfx.hpp b/port/gfx/gfx.hpp
index 5a27ece..54843aa 100644
--- a/port/gfx/gfx.hpp
+++ b/port/gfx/gfx.hpp
@@ -28,10 +28,24 @@ enum class AspectMode : uint8_t {
     Letterbox,
 };
 
+// For code built against Kazarov before FrameLayout::cover.
+#define KZ_GFX_COVER_MODE 1
+
+// With AspectMode::Fill, what becomes of a 2D draw that covers the whole frame with an ordinary
+// texture (a cutscene still, a full-screen backdrop) where the window shows past the frame.
+enum class CoverMode : uint8_t {
+    // Stretched to the window's edges.
+    Stretch,
+    // Kept at the frame's shape, with black at its sides drawn as the picture is (its alpha and
+    // blending), so a picture that fades fades its bars with it.
+    Fit,
+};
+
 struct FrameLayout {
     AspectMode aspect = AspectMode::Fill;
     // 2D that tests no depth, scaled about the main target's centre.
-    float ui_scale = 1.0f;
+    float     ui_scale = 1.0f;
+    CoverMode cover = CoverMode::Stretch;
 };
 
