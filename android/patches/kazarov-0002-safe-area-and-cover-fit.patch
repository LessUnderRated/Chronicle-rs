+
+// A picture covering the whole frame in a window twice as wide: stretched to the window's edges, or
+// with CoverMode::Fit kept at the frame's place with black bars beside it.
+TEST(GfxMisc, CoverFitKeepsTheFrameShape) {
+    GfxFixture fixture(1280, 480);
+    gfx::TextureHandle texture = gfx::CreateTexture({1, 1, gfx::TextureFormat::Rgba8, 1, true});
+    ASSERT_NE(texture, gfx::kNullTexture);
+    uint32_t white = Rgba(255, 255, 255);
+    ASSERT_TRUE(gfx::UpdateTexture(texture, 0, 0, 0, 1, 1, &white));
+    auto still = [&] {
+        gfx::TextureBinding binding;
+        binding.texture = texture;
+        auto quad = Quad(0, 0, 640, 480, {0x80, 0x80, 0x80, 0x80}, 0, 0, 1, 1);
+        gfx::Draw2D(gfx::Primitive::Quads, quad, binding, gfx::DrawState{});
+    };
+    const std::array<uint8_t, 4> blue = {0, 0, 0xFF, 0x80};
+
+    gfx::SetFrameLayout({gfx::AspectMode::Fill, 1.0f, gfx::CoverMode::Stretch});
+    fixture.Frame(blue, still);
+    EXPECT_TRUE(fixture.PixelNear(100, 240, 255, 255, 255)) << "stretched over the side";
+    EXPECT_TRUE(fixture.PixelNear(640, 240, 255, 255, 255));
+
+    gfx::SetFrameLayout({gfx::AspectMode::Fill, 1.0f, gfx::CoverMode::Fit});
+    fixture.Frame(blue, still);
+    EXPECT_TRUE(fixture.PixelNear(100, 240, 0, 0, 0)) << "a black bar on the left";
+    EXPECT_TRUE(fixture.PixelNear(1180, 240, 0, 0, 0)) << "and on the right";
+    EXPECT_TRUE(fixture.PixelNear(640, 240, 255, 255, 255)) << "the picture at the frame's place";
+    EXPECT_TRUE(fixture.PixelNear(330, 240, 255, 255, 255));
+    EXPECT_TRUE(fixture.PixelNear(310, 240, 0, 0, 0));
+
+    // A HUD piece that does not cover the frame grows no bars.
+    fixture.Frame(blue, [&] {
+        gfx::TextureBinding binding;
+        binding.texture = texture;
+        auto quad = Quad(0, 0, 100, 100, {0x80, 0x80, 0x80, 0x80}, 0, 0, 1, 1);
+        gfx::Draw2D(gfx::Primitive::Quads, quad, binding, gfx::DrawState{});
+    });
+    EXPECT_TRUE(fixture.PixelNear(100, 240, 0, 0, 255));
+    gfx::DestroyTexture(texture);
+}
