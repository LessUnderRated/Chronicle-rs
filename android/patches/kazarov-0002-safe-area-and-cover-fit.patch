+// How far the window's safe area (SDL_GetWindowSafeArea: clear of a display cutout, the system's
+// bars and gesture edges) lies inside each edge of the main target, in its pixels. All zero for a
+// window without one, offscreen, and with AspectMode::Letterbox, which keeps the HUD in the frame.
+struct SafeInsets {
+    float left = 0.0f;
+    float top = 0.0f;
+    float right = 0.0f;
+    float bottom = 0.0f;
+};
+
+SafeInsets MainSafeInsets(const LogicalMapping &logical) {
+    SafeInsets insets;
+    if (g.offscreen || g.window == nullptr || !FillsWindow()) {
+        return insets;
+    }
+    SDL_Rect safe;
+    int      width = 0;
+    int      height = 0;
+    if (!SDL_GetWindowSafeArea(g.window, &safe) || !SDL_GetWindowSize(g.window, &width, &height) || width <= 0 ||
+        height <= 0) {
+        return insets;
+    }
+    float to_x = static_cast<float>(logical.pixel_width) / static_cast<float>(width);
+    float to_y = static_cast<float>(logical.pixel_height) / static_cast<float>(height);
+    insets.left = std::max(0, safe.x) * to_x;
+    insets.top = std::max(0, safe.y) * to_y;
+    insets.right = std::max(0, width - safe.x - safe.w) * to_x;
+    insets.bottom = std::max(0, height - safe.y - safe.h) * to_y;
+    return insets;
+}
